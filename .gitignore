# Build output. `target/` matches at any depth: a crate that was built
# standalone before this became a workspace keeps its own.
target/
**/*.rs.bk

# Tokenizer vocabularies are fetched, not committed (6 MB each, model-owned).
/assets/tokenizer.json
/assets/tokenizers/

# Differential-test artifacts: regenerated by the commands in diff/REPORT.md.
/diff/out-*.json
/diff/tok-*.json
/diff/tok-run.log
